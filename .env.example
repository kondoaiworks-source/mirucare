# =========================================================
# 監査のミカタ — 環境変数テンプレート
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
# =========================================================

# サイトURL（招待リンク・Authコールバック用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（Auth / Postgres / Storage / RLS）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dify API（サーバーサイドからのみ使用。クライアント・Git・チャットに書かない）
# 未設定または DIFY_MOCK=1 のときはモック応答を使用（本番ではモック禁止・エラー）
DIFY_API_KEY=
# オリジンのみ（末尾の /v1 はコード側で付与。https://api.dify.ai/v1 でも可）
DIFY_BASE_URL=https://api.dify.ai
DIFY_MOCK=0
# モックシナリオ: success | parse_error | empty（DIFY_MOCK=1 のローカルのみ）
DIFY_MOCK_SCENARIO=success
# Workflow 開始ノードの File Array 変数名（Vision で選ぶ document_image と一致）
DIFY_FILE_INPUT_KEY=document_image

# Stripe（サブスクリプション課金・テストモード）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout 用 Price ID（price_ で始まる。prod_ の商品IDではない）
STRIPE_PRICE_LIGHT=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PREMIUM=price_...
# 初期導入費（一回限り・任意。未設定なら Checkout に含めない）
STRIPE_PRICE_SETUP=price_...

# 期限リマインドメール（Resend）＋ Cron
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Vercel Cron / 手動 curl の Authorization: Bearer と同じ値。未設定だと Cron は常に 401
CRON_SECRET=

# 行政マニュアル監視（公的サイトへの配慮）
# User-Agent に載せる連絡先。未設定時は OPERATOR_EMAILS の先頭、さらになければ ops@example.com
KNOWLEDGE_SYNC_CONTACT_EMAIL=
# 任意。指定時は連絡先付きデフォルト UA の代わりにこの文字列を使う
KNOWLEDGE_SYNC_USER_AGENT=
# 対象間の待機秒数（下限5秒。それ未満は切り上げ）
KNOWLEDGE_SYNC_INTERVAL_SEC=5

# 差分AI整理（Gemini・サーバーサイドのみ。未設定時は「AI整理なし」ドラフトを作成）
GEMINI_API_KEY=
# 任意。未設定時は gemini-3.5-flash（2.5-pro は新規キーで 404 になる）
GEMINI_MODEL=gemini-3.5-flash

# 運営レビューコンソール（カンマ区切りメール。profiles.is_operator でも可）
OPERATOR_EMAILS=

# 施設向け AI チェックに渡すルール範囲（未設定または phase1 = 項目1/3/7/8 のみ）
# 検証で全承認ルールを渡すときだけ all
# CHECK_RULES_SCOPE=all

# Phase1 AIルール CLI シード時の承認者 profiles.id
# SEED_OPERATOR_PROFILE_ID=
