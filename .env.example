# =========================================================
# 監査のミカタ — 環境変数テンプレート
# このファイルをコピーして .env.local を作成してください
# cp .env.example .env.local
# =========================================================

# サイトURL（招待リンク・Authコールバック用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（Auth / Postgres / Storage / RLS）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dify API（サーバーサイドからのみ使用。クライアントに露出させない）
# 未設定または DIFY_MOCK=1 のときはモック応答を使用
DIFY_API_KEY=
DIFY_BASE_URL=https://api.dify.ai
DIFY_MOCK=1
# モックシナリオ: success | parse_error | empty
DIFY_MOCK_SCENARIO=success

# Stripe（サブスクリプション課金・テストモード）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Checkout 用 Price ID（price_ で始まる。prod_ の商品IDではない）
STRIPE_PRICE_LIGHT=price_...
STRIPE_PRICE_STANDARD=price_...
STRIPE_PRICE_PREMIUM=price_...
# 初期導入費（一回限り・任意。未設定なら Checkout に含めない）
STRIPE_PRICE_SETUP=price_...

# 期限リマインドメール（Resend）＋ Cron
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=

# 運営レビューコンソール（カンマ区切りメール。profiles.is_operator でも可）
OPERATOR_EMAILS=
